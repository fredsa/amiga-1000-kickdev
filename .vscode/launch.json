{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "amiga-assembly",
            "request": "launch",
            "name": "Kickdev ROM Launch",
            "noDebug": true,
            "program": "${workspaceFolder}/uae/dh0/myprogram",
            "remoteProgram": "SYS:myprogram",
            "emulatorType": "winuae",
            "emulatorArgs": [
                "-s", "chipset=ocs",
                "-s", "chipset_compatible=A1000",
                "-s", "floppy_speed=800",
                "-v", "0", // Chipset: 0 (A1000 without EHB), 1 (A1000), 2 (OCS), 3 (ECS Agnus), 4 (ECS Denise), 5 (Full ECS), 6 (AGA)
                "-c", "1", // 1* 512kB chipmen
                "-s", "gfx_width=1600",
                "-s", "gfx_height=1200",
                "-w", "-1", // CPU: 0=cycle exact, -1=max speed
                "-s", "kickstart_rom_file=${workspaceFolder}/build/kickdev.rom"
            ],
            "preLaunchTask": "Kickdev build boot ROM"
        },
        {
            "type": "amiga-assembly",
            "request": "launch",
            "name": "Kickdev Kickstart Launch",
            "noDebug": true,
            "program": "${workspaceFolder}/uae/dh0/myprogram",
            "remoteProgram": "SYS:myprogram",
            "emulatorType": "winuae",
            "emulatorArgs": [
                "-s", "chipset=ocs",
                "-s", "chipset_compatible=A1000",
                "-s", "floppy_speed=800",
                "-v", "0", // Chipset: 0 (A1000 without EHB), 1 (A1000), 2 (OCS), 3 (ECS Agnus), 4 (ECS Denise), 5 (Full ECS), 6 (AGA)
                "-c", "1", // 1* 512kB chipmen
                "-s", "gfx_width=1600",
                "-s", "gfx_height=1200",
                "-w", "-1", // CPU: 0=cycle exact, -1=max speed
                "-s", "kickstart_rom_file=${workspaceFolder}/rom/Amiga 1000 ROM Bootstrap (1985)(Commodore)(A1000)[u].rom",
                "-0", "${workspaceFolder}/build/kickstart.adf",
            ],
            "preLaunchTask": "Kickdev build kickstart ADF"
        },
        {
            "type": "amiga-assembly",
            "request": "launch",
            "name": "FS-UAE Debug",
            "stopOnEntry": false,
            "program": "${workspaceFolder}/uae/dh0/myprogram",
            "remoteProgram": "SYS:myprogram",
            "emulatorType": "fs-uae",
            "emulatorArgs": [
                "--hard_drive_0=${workspaceFolder}/uae/dh0",
                "--automatic_input_grab=0"
            ],
            "preLaunchTask": "amigaassembly: build"
        },
        {
            "type": "amiga-assembly",
            "request": "launch",
            "name": "FS-UAE Launch",
            "noDebug": true,
            "program": "${workspaceFolder}/uae/dh0/myprogram",
            "remoteProgram": "SYS:myprogram",
            "emulatorType": "fs-uae",
            "emulatorArgs": [
                "--hard_drive_0=${workspaceFolder}/uae/dh0",
                "--automatic_input_grab=0"
            ],
            "preLaunchTask": "amigaassembly: build"
        },
        {
            "type": "amiga-assembly",
            "request": "launch",
            "name": "WinUAE Debug",
            "stopOnEntry": false,
            "program": "${workspaceFolder}/uae/dh0/myprogram",
            "remoteProgram": "SYS:myprogram",
            "emulatorType": "winuae",
            "emulatorArgs": [
                "-s",
                "filesystem=rw,dh0:${workspaceFolder}/uae/dh0"
            ],
            "preLaunchTask": "amigaassembly: build"
        },
        {
            "type": "amiga-assembly",
            "request": "launch",
            "name": "WinUAE Launch",
            "noDebug": true,
            "program": "${workspaceFolder}/uae/dh0/myprogram",
            "remoteProgram": "SYS:myprogram",
            "emulatorType": "winuae",
            "emulatorArgs": [
                "-s",
                "filesystem=rw,dh0:${workspaceFolder}/uae/dh0"
            ],
            "preLaunchTask": "amigaassembly: build"
        },
        {
            "type": "amiga-assembly",
            "request": "launch",
            "name": "Copperline Debug",
            "emulatorType": "copperline",
            "program": "${workspaceFolder}/uae/dh0/myprogram",
            "stopOnEntry": true,
            "copperlineOptions": {
                "factory": true
            },
            "preLaunchTask": "amigaassembly: build"
        }
    ]
}