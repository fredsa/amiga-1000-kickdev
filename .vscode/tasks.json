{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Kickdev build kickdev.adf (256kB)",
			"detail": "Create 880kB Kickstart ADF image: 'KICK', $00 x 508, ROM bytes, $00 padded",
			"type": "shell",
			"dependsOn": [
				"Kickdev build kickdev.adf (unpadded)",
			],
			"windows": {
				"command": "powershell",
				"args": [
					"-NoProfile",
					"-Command",
					"$f = [System.IO.File]::Open('${workspaceFolder}/build/kickdev.adf', 'OpenOrCreate'); $f.SetLength(901120); $f.Close()"
				]
			},
			"osx": {
				"command": "truncate",
				"args": [
					"-s",
					"901120",
					"${workspaceFolder}/build/kickdev.adf"
				]
			},
			"linux": {
				"command": "truncate",
				"args": [
					"-s",
					"901120",
					"${workspaceFolder}/build/kickdev.adf"
				]
			},
			"problemMatcher": []
		},
		{
			"label": "Kickdev build kickdev.adf (unpadded)",
			"type": "shell",
			"dependsOn": [
				"Kickdev build",
			],
			"command": "cat disk/kick512.bin build/kickdev.rom > build/kickdev.adf",
			"problemMatcher": [
				"$vasm"
			]
		},
		{
			"label": "Kickdev build kickdev.rom (8kB)",
			"type": "shell",
			"dependsOn": [
				"Kickdev build",
			],
			"windows": {
				"command": "powershell",
				"args": [
					"-NoProfile",
					"-Command",
					"$f = [System.IO.File]::Open('${workspaceFolder}/build/kickdev.rom', 'OpenOrCreate'); $f.SetLength(8192); $f.Close()"
				]
			},
			"osx": {
				"command": "truncate",
				"args": [
					"-s",
					"8192",
					"${workspaceFolder}/build/kickdev.rom"
				]
			},
			"linux": {
				"command": "truncate",
				"args": [
					"-s",
					"8192",
					"${workspaceFolder}/build/kickdev.rom"
				]
			},
			"problemMatcher": []
		},
		{
			"label": "Kickdev build",
			"type": "shell",
			"command": "${env:USERPROFILE}/.vscode/extensions/prb28.amiga-assembly-1.9.0/resources/bin/win32/vasmm68k_mot.exe",
			"args": [
				"-m68000",
				"-Fbin",
				"${workspaceFolder}/main.asm",
				"-o",
				"${workspaceFolder}/build/kickdev.rom"
			],
			"problemMatcher": [
				"$vasm"
			]
		},
		{
			"type": "amigaassembly",
			"vasm": {
				"enabled": true,
				"command": "${config:amiga-assembly.binDir}/vasmm68k_mot",
				"args": [
					"-m68000",
					"-Fhunk",
					"-linedebug"
				],
				"leaveWarnings": true
			},
			"vlink": {
				"enabled": true,
				"command": "${config:amiga-assembly.binDir}/vlink",
				"includes": "*.{s,S,asm,ASM}",
				"excludes": "",
				"createStartupSequence": true,
				"createExeFileParentDir": true,
				"exefilename": "../uae/dh0/myprogram",
				"args": [
					"-bamigahunk",
					"-Bstatic"
				]
			},
			"problemMatcher": [
				"$vasm"
			],
			"group": "build",
			"label": "amigaassembly: build"
		},
		{
			"type": "amigaassembly",
			"vasm": {
				"enabled": true,
				"command": "${config:amiga-assembly.binDir}/vasmm68k_mot",
				"args": [
					"-m68000",
					"-Fhunk",
					"-linedebug"
				],
				"leaveWarnings": true
			},
			"vlink": {
				"enabled": true,
				"command": "${config:amiga-assembly.binDir}/vlink",
				"createStartupSequence": true,
				"createExeFileParentDir": true,
				"exefilename": "../uae/dh0/myprogram",
				"args": [
					"-bamigahunk",
					"-Bstatic"
				]
			},
			"problemMatcher": [
				"$vasm"
			],
			"label": "amigaassembly: build current file"
		},
		{
			"type": "amigaassembly",
			"vasm": {
				"enabled": true,
				"command": "${config:amiga-assembly.binDir}/vasmm68k_mot",
				"args": [
					"-m68000",
					"-Fhunk",
					"-linedebug"
				],
				"leaveWarnings": true
			},
			"problemMatcher": [
				"$vasm"
			],
			"label": "amigaassembly: compile current file"
		},
		{
			"type": "amigaassembly",
			"adfgenerator": {
				"ADFToolsParentDir": "${config:amiga-assembly.binDir}",
				"sourceRootDir": "uae/dh0",
				"outputADFFile": "./build/disk.adf",
				"includes": "**/*",
				"excludes": "**/.*",
				"adfCreateOptions": [
					"--label=MYDISK"
				]
			},
			"problemMatcher": [
				"$vasm"
			],
			"label": "amigaassembly: create ADF"
		}
	]
}